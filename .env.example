# Google Cloud で「Maps JavaScript API」と「Places API (New)」を有効にしたキー
VITE_GOOGLE_MAPS_API_KEY=
# 任意：Google Cloud で作ったマップ ID（未設定ならデモ用 ID）
VITE_GOOGLE_MAP_ID=

# --- サーバー側（Vercel の Environment Variables に設定） ---
# TikTok 動画の検索に使う Brave Search API のキー
BRAVE_SEARCH_API_KEY=
# 検索結果をみんなで共有するための Upstash Redis（Vercel の Storage からつなぐと自動で入る）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# この合言葉を知っている人だけが使える（未設定だと検索 API は止まる）
APP_PASSCODE=
